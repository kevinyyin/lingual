# Copy to .env and fill in only the keys for the providers you run.
# .env is git-ignored. The harness reads ONLY this file (latency-bench/.env),
# plus any variables already exported in your shell.

# provider: openai (gpt-realtime-translate). Also the default key for the cascade's
# translate LLM, the EVS word aligner, the optional LLM judge, and `prepare --tts openai`.
OPENAI_API_KEY=

# provider: gemini (Gemini Live Translate)
GEMINI_API_KEY=

# provider: cascade (Deepgram Flux STT -> LLM -> Cartesia Sonic TTS)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# optional: round-2 experiment 6 (Groq translation backend)
GROQ_API_KEY=

# optional: only if config/bench.yaml points an LLM role at Anthropic
ANTHROPIC_API_KEY=

# optional: free-text location label stored in run metadata (e.g. "Seattle, home Wi-Fi")
BENCH_LOCATION=
