{
  "version": "0.0.1",
  "configurations": [
    { "name": "asl-server", "runtimeExecutable": "uv", "runtimeArgs": ["--directory", "app", "run", "asl-server"], "port": 8000 },
    { "name": "asl-server-py", "runtimeExecutable": "uv", "runtimeArgs": ["--directory", "app", "run", "python", "-c", "from server.main import run; run()"], "port": 8000 },
    { "name": "asl-web","runtimeExecutable": "npm", "runtimeArgs": ["--prefix", "app/web", "run", "dev", "--", "--port", "5173", "--strictPort"], "port": 5173 },
    { "name": "asl-server-tunnel", "runtimeExecutable": "env", "runtimeArgs": ["ALLOWED_ORIGINS=https://ghz-faqs-punch-replied.trycloudflare.com", "uv", "--directory", "app", "run", "asl-server"], "port": 8000 },
    { "name": "asl-web-tunnel", "runtimeExecutable": "npm", "runtimeArgs": ["--prefix", "app/web", "run", "dev:tunnel", "--", "--port", "5173", "--strictPort"], "port": 5173 },
    { "name": "asl-server-alt", "runtimeExecutable": "env", "runtimeArgs": ["PORT=8010", "uv", "--directory", "app", "run", "asl-server"], "port": 8010 },
    { "name": "asl-web-alt", "runtimeExecutable": "env", "runtimeArgs": ["API=http://localhost:8010", "npm", "--prefix", "app/web", "run", "dev", "--", "--port", "5180", "--strictPort"], "port": 5180 }
  ]
}
